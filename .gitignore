# ─── Java / Maven Build Outputs ───────────────────────────
target/
*.jar
!rcp-backend-1.0.0.jar
!RCP-DEPLOY/rcp-backend-1.0.0.jar
*.war
*.class
*.original

# ─── IDE Files ────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Logs ─────────────────────────────────────────────────
*.log
backend-startup.log
backend-error.log

# ─── Uploaded Files (user uploads, not source code) ───────
uploads/

# ─── Scratch / Dev Scripts (not needed in repo) ───────────
scratch/

# ─── RCP-DEPLOY (Allow deployment folder) ──────────────────
!RCP-DEPLOY/
!RCP-DEPLOY/**

# ─── Large / Binary Files ─────────────────────────────────
*.zip
*.pdf
*.sql
!rcp_db_backup.sql
!RCP-DEPLOY/rcp_db_backup.sql
*.docx
!RCP_University_Deployment_Guide.docx
*.xlsx

# ─── OS Files ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Python Cache ─────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ─── Spring Boot Application Properties (keep template, ignore local overrides) ──
# Uncomment below if you have secrets in application.properties:
# src/main/resources/application.properties

# ─── Node (if any frontend tooling added later) ───────────
node_modules/
